  "source": [
    "class Record:",
    "    @staticmethod",
    "    def echo(value: str) -> str:",
    "        return value",
    "    @classmethod",
    "    def create(cls) -> Record:",
    "        return cls()",
    "record: Record = Record.create()",
    "result: str = record.echo(\"Ada\")"
