  "source": [
    "def read(flag: bool) -> str:",
    "    try:",
    "        if flag:",
    "            raise ValueError(\"missing\")",
    "    except ValueError as error:",
    "        return \"missing\"",
    "    else:",
    "        return \"ready\"",
    "    finally:",
    "        flag = False",
    "print(read(False), read(True))"
  ],
