  "source": [
    "type Keys = keyof { id: int, \"id\": str }",
    "type Attrs = Extract(Keys, *)",
    "type Items = Exclude(Keys, *)",
    "attr: Attrs",
    "name: *<\"id\"> = attr",
    "item: Items = \"id\"",
    "invalid: Keys = \"__str__\""
