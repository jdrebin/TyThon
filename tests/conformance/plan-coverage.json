    {
      "id": "cli-emission",
      "command": [
        "go",
        "test",
        "./tsc/cmd/tsc",
        "-run",
        "^(TestCollectPythonInputsDiscoversImportedProjectDeclarations|TestCollectPythonInputsRejectsPythonFiles|TestPythonEmitSeparateTreeAndRepeatBuild|TestPythonEmitRejectsUnsafeTargets|TestPythonEmitInfersCommonSourceRoot)$",
        "-count=1",
        "-timeout=120s"
      ],
      "files": [
        {
          "path": "tsc/cmd/tsc/python_test.go",
          "tests": [
            "TestCollectPythonInputsDiscoversImportedProjectDeclarations",
