type DisplayName = <T extends str>(value: T) -> T
type User = {id: int, "name": str, optional "nickname": str}

identity = lambda<T extends str> value: T: value


def welcome(name: str = "world") -> str:
    return f"Hello, {name}"


message = identity(welcome())
