{
    "def": {
        "prefix": "def",
        "body": ["def ${1:name}($2):", "    ${0:pass}"],
        "description": "Function definition"
    },
    "async def": {
        "prefix": "async def",
        "body": ["async def ${1:name}($2):", "    ${0:pass}"],
        "description": "Async function definition"
    },
    "class": {
        "prefix": "class",
        "body": ["class ${1:Name}:", "    ${0:pass}"],
        "description": "Class definition"
    },
    "if": {
        "prefix": "if",
        "body": ["if ${1:condition}:", "    ${0:pass}"],
        "description": "If statement"
    },
    "for": {
        "prefix": "for",
        "body": ["for ${1:item} in ${2:iterable}:", "    ${0:pass}"],
        "description": "For loop"
    },
    "while": {
        "prefix": "while",
        "body": ["while ${1:condition}:", "    ${0:pass}"],
        "description": "While loop"
    },
    "try": {
        "prefix": "try",
        "body": ["try:", "    ${1:pass}", "except ${2:Exception}:", "    ${0:pass}"],
        "description": "Try/except"
    },
    "with": {
        "prefix": "with",
        "body": ["with ${1:expr} as ${2:name}:", "    ${0:pass}"],
        "description": "With statement"
    },
    "__init__": {
        "prefix": "__init__",
        "body": ["def __init__(self${1:, }):", "    ${0:pass}"],
        "description": "Initializer"
    }
}
