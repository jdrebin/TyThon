from typing import Any, Literal, Optional, Union, List, Dict, Tuple, overload, TypeAlias

Identifier: TypeAlias = Union[int, str]
version: str
def read(key: str, /, *, fallback: Optional[str] = ...) -> str | None: ...
def collect(*items: int, **labels: str) -> Tuple[int, str]: ...
@overload
def select(value: Literal[True]) -> List[str]: ...
@overload
def select(value: Literal[False]) -> Dict[str, int]: ...
class User:
    name: str
    def __init__(self, name: str) -> None: ...
    def greet(self, prefix: str) -> str: ...
