type Identifier = (int | str)
version: str
declare def read(key: str, /, *, fallback: (str | None) = ...) -> (str | None): ...
declare def collect(*items: ()(int), **labels: Dict({ (str): str })) -> (int, str): ...
@overload
declare def select(value: (True)) -> list<str>: ...
@overload
declare def select(value: (False)) -> Dict({ (str): int }): ...
declare class User:
    name: str
    def __init__(self, name: str) -> None: ...
    def greet(self, prefix: str) -> str: ...
