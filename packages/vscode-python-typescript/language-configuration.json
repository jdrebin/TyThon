{
    "comments": {
        "lineComment": "#"
    },
    "brackets": [
        ["(", ")"],
        ["[", "]"],
        ["{", "}"]
    ],
    "autoClosingPairs": [
        { "open": "(", "close": ")" },
        { "open": "[", "close": "]" },
        { "open": "{", "close": "}" },
        { "open": "\"", "close": "\"", "notIn": ["string"] },
        { "open": "'", "close": "'", "notIn": ["string", "comment"] },
        { "open": "`", "close": "`", "notIn": ["string", "comment"] }
    ],
    "surroundingPairs": [
        ["(", ")"],
        ["[", "]"],
        ["{", "}"],
        ["\"", "\""],
        ["'", "'"],
        ["`", "`"]
    ],
    "wordPattern": "(-?\\d*\\.\\d\\w*)|([A-Za-z_]\\w*)",
    "indentationRules": {
        "increaseIndentPattern": "^\\s*(?:async\\s+)?(?:def|class|for|if|elif|else|while|try|with|finally|except|match|case)\\b.*:\\s*(#.*)?$",
        "decreaseIndentPattern": "^\\s*(?:else|elif|except|finally)(?:\\s*:|\\s+\\S.*:)\\s*(#.*)?$"
    },
    "onEnterRules": [
        {
            "beforeText": "^\\s*(?:async\\s+)?(?:def|class)\\b.*:\\s*(#.*)?$",
            "action": { "indent": "indent" }
        },
        {
            "beforeText": "^\\s*(?:elif|else|except|finally)\\b.*:\\s*(#.*)?$",
            "action": { "indent": "indent" }
        },
        {
            "beforeText": "^\\s*(?:for|if|while|try|with|match|case)\\b.*:\\s*(#.*)?$",
            "action": { "indent": "indent" }
        }
    ],
    "folding": {
        "offSide": true,
        "markers": {
            "start": "^\\s*#\\s*region\\b",
            "end": "^\\s*#\\s*endregion\\b"
        }
    }
}
