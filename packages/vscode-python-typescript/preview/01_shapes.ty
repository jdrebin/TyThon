# Hover the definitions, then try dot and quoted-key completion.
type User = { "id": int, "name": str }
type StoredUser = Dict(User)

user: StoredUser = {"id": 12, "name": "Kate"}
name = user["name"]
maybe_name = user.get("name")
keys = user.keys()

type Patch = { ?"name": str }

def display(patch: Dict(Patch)):
    if "name" in patch:
        return patch["name"]
    return "Anonymous"

names = ["John", "Kate"]
pair = ("John", "Kate")

# For an open map, put the index signature in the shape.
def read_count(counts: Dict({ (str): int }), key: str):
    return counts[key]
